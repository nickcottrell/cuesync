# Cuesync Secrets Configuration
# Copy this file to .env and fill in your values

# === UPWORK API ===
# Get credentials from: https://www.upwork.com/ab/account-security/api
UPWORK_CLIENT_ID=your_client_id_here
UPWORK_CLIENT_SECRET=your_client_secret_here
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=

# === ZAPIER WEBHOOKS ===
# Get webhook URLs from your Zapier zaps
ZAPIER_WEBHOOK_EMAIL_ME=https://hooks.zapier.com/hooks/catch/...
ZAPIER_WEBHOOK_APPROVAL_LOOP=https://hooks.zapier.com/hooks/catch/...
ZAPIER_WEBHOOK_ADD_TO_TRELLO=https://hooks.zapier.com/hooks/catch/...
ZAPIER_WEBHOOK_SCHEDULE_EVENT=https://hooks.zapier.com/hooks/catch/...

# === PREFERENCES ===
UPWORK_MIN_BUDGET=50
UPWORK_MAX_BUDGET=500
UPWORK_DAILY_PROPOSAL_LIMIT=5
UPWORK_FREELANCER_NAME=Your Name
UPWORK_HOURLY_RATE=75
