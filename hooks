#!/bin/bash
# CueSync Hooks - Standard Commands with Logging
# Provides clean interface for all CueSync operations

set -e

# Configuration
HOOKS_LOG_DIR="logs"
HOOKS_LOG_FILE="$HOOKS_LOG_DIR/hooks.log"
STATIC_IP=${STATIC_IP:-"3.138.41.20"}
INSTANCE_NAME=${INSTANCE_NAME:-"cuesync-node"}

# Create logs directory
mkdir -p "$HOOKS_LOG_DIR"

# Logging function
log_command() {
    local command=$1
    local status=$2
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "[$timestamp] $command | status=$status" >> "$HOOKS_LOG_FILE"
}

# Display usage
usage() {
    cat <<EOF
CueSync Hooks - Standard Commands

Usage: ./hooks <command> [options]

DEPLOYMENT:
  deploy              Deploy CueSync to Lightsail instance
  status              Check CueSync server status
  health              Check health endpoint
  stats               Show execution statistics
  logs [lines]        View server logs (default: 50 lines)

ROTATION:
  rotate [days]       Rotate keys (Layer 1, fast ~30s)
  rotate-instance [days]  Rotate entire instance (Layer 2, ~5min)
  teardown            Complete destruction (Layer 3)

MONITORING:
  check-health        Run health check for compromise detection
  watch-logs          Watch logs in real-time
  db-stats            Query database statistics

UTILITIES:
  test                Send test cue to verify end-to-end
  ssh                 SSH into CueSync instance
  keygen              Generate new key and hash
  ip                  Show static IP information
  help                Show this help message

LOGS:
  All commands are logged to: $HOOKS_LOG_FILE

EXAMPLES:
  ./hooks deploy                    # Deploy to Lightsail
  ./hooks rotate 90                 # Rotate keys, expire in 90 days
  ./hooks rotate-instance 180       # Fresh instance, expire in 180 days
  ./hooks health                    # Check server health
  ./hooks logs 100                  # View last 100 log lines
  ./hooks test                      # Send test cue

ENVIRONMENT VARIABLES:
  STATIC_IP           Static IP address (default: $STATIC_IP)
  INSTANCE_NAME       Lightsail instance name (default: $INSTANCE_NAME)
  EXPIRES_DAYS        Days until expiration (default: 30)

EOF
}

# Command implementations
cmd_deploy() {
    echo "Deploying CueSync..."
    log_command "deploy" "started"

    export SERVER_HOST="$INSTANCE_NAME"
    export SERVER_USER="ubuntu"
    export REMOTE_DIR="/home/ubuntu/cuesync"
    export CUESYNC_PORT="8080"

    if ./scripts/deploy.sh; then
        log_command "deploy" "success"
        echo "✅ Deployment complete"
    else
        log_command "deploy" "failed"
        echo "❌ Deployment failed"
        exit 1
    fi
}

cmd_status() {
    echo "Checking CueSync status..."
    log_command "status" "checking"

    if ssh "$INSTANCE_NAME" 'sudo systemctl status cuesync --no-pager'; then
        log_command "status" "running"
    else
        log_command "status" "not_running"
        exit 1
    fi
}

cmd_health() {
    echo "Checking health endpoint..."
    log_command "health" "checking"

    if curl -sf "http://$STATIC_IP:8080/health" | python3 -m json.tool; then
        log_command "health" "healthy"
    else
        log_command "health" "unhealthy"
        echo "❌ Health check failed"
        exit 1
    fi
}

cmd_stats() {
    echo "Fetching execution statistics..."
    log_command "stats" "fetching"

    curl -s "http://$STATIC_IP:8080/stats" | python3 -m json.tool
    log_command "stats" "success"
}

cmd_logs() {
    local lines=${1:-50}
    echo "Fetching last $lines log lines..."
    log_command "logs" "fetching:$lines"

    ssh "$INSTANCE_NAME" "sudo journalctl -u cuesync -n $lines --no-pager"
    log_command "logs" "success"
}

cmd_rotate() {
    local days=${1:-30}
    echo "Rotating keys (Layer 1)..."
    log_command "rotate" "started:${days}days"

    export EXPIRES_DAYS=$days
    if ./scripts/rotate.sh; then
        log_command "rotate" "success:${days}days"
        echo "✅ Key rotation complete"
    else
        log_command "rotate" "failed"
        echo "❌ Rotation failed"
        exit 1
    fi
}

cmd_rotate_instance() {
    local days=${1:-30}
    echo "Rotating instance (Layer 2)..."
    log_command "rotate-instance" "started:${days}days"

    export EXPIRES_DAYS=$days
    if ./scripts/rotate-instance.sh; then
        log_command "rotate-instance" "success:${days}days"
        echo "✅ Instance rotation complete"
    else
        log_command "rotate-instance" "failed"
        echo "❌ Instance rotation failed"
        exit 1
    fi
}

cmd_teardown() {
    echo "Complete teardown (Layer 3)..."
    log_command "teardown" "started"

    if ./scripts/teardown.sh; then
        log_command "teardown" "success"
        echo "✅ Teardown complete"
    else
        log_command "teardown" "failed"
        echo "❌ Teardown failed"
        exit 1
    fi
}

cmd_check_health() {
    echo "Running health check..."
    log_command "check-health" "started"

    if ./scripts/check-health.sh; then
        log_command "check-health" "success"
    else
        log_command "check-health" "warnings"
    fi
}

cmd_watch_logs() {
    echo "Watching logs in real-time (Ctrl+C to exit)..."
    log_command "watch-logs" "started"

    ssh "$INSTANCE_NAME" 'sudo journalctl -u cuesync -f'
}

cmd_db_stats() {
    echo "Querying database statistics..."
    log_command "db-stats" "started"

    ssh "$INSTANCE_NAME" "cd /home/ubuntu/cuesync && sqlite3 cuesync.db 'SELECT status, COUNT(*) FROM cues GROUP BY status'"
    log_command "db-stats" "success"
}

cmd_test() {
    echo "Sending test cue..."
    log_command "test" "started"

    # Check if dispatcher exists in maestro
    if [ -d "../maestro/.cue-dispatcher" ]; then
        cd ../maestro
        if .cue-dispatcher/dispatch.sh .cue-dispatcher/examples/test.json; then
            cd - > /dev/null
            log_command "test" "success"
            echo "✅ Test cue dispatched successfully"
            echo "Wait 60 seconds for worker to execute..."
        else
            cd - > /dev/null
            log_command "test" "failed"
            echo "❌ Test failed"
            exit 1
        fi
    else
        log_command "test" "no_dispatcher"
        echo "❌ Dispatcher not found at ../maestro/.cue-dispatcher"
        exit 1
    fi
}

cmd_ssh() {
    echo "Connecting to CueSync instance..."
    log_command "ssh" "started"

    ssh "$INSTANCE_NAME"
    log_command "ssh" "closed"
}

cmd_keygen() {
    echo "Generating new key and hash..."
    log_command "keygen" "started"

    local key=$(openssl rand -hex 32)
    local hash=$(echo -n "$key" | openssl dgst -sha256 | awk '{print $2}')

    echo
    echo "Upstream Key: $key"
    echo "SHA-256 Hash: $hash"
    echo
    echo "Add to config.yaml:"
    echo "  upstream_key_hash: \"$hash\""
    echo

    log_command "keygen" "success"
}

cmd_ip() {
    echo "Fetching static IP information..."
    log_command "ip" "fetching"

    aws lightsail get-static-ip --static-ip-name cuesync-static-ip | python3 -m json.tool
    log_command "ip" "success"
}

cmd_show_logs() {
    echo "=== CueSync Hooks Log ==="
    echo
    if [ -f "$HOOKS_LOG_FILE" ]; then
        tail -n 50 "$HOOKS_LOG_FILE"
        echo
        echo "Full log: $HOOKS_LOG_FILE"
    else
        echo "No log file found yet."
    fi
}

# Main command router
main() {
    local command=${1:-help}

    case "$command" in
        deploy)
            cmd_deploy
            ;;
        status)
            cmd_status
            ;;
        health)
            cmd_health
            ;;
        stats)
            cmd_stats
            ;;
        logs)
            cmd_logs "$2"
            ;;
        rotate)
            cmd_rotate "$2"
            ;;
        rotate-instance)
            cmd_rotate_instance "$2"
            ;;
        teardown)
            cmd_teardown
            ;;
        check-health)
            cmd_check_health
            ;;
        watch-logs)
            cmd_watch_logs
            ;;
        db-stats)
            cmd_db_stats
            ;;
        test)
            cmd_test
            ;;
        ssh)
            cmd_ssh
            ;;
        keygen)
            cmd_keygen
            ;;
        ip)
            cmd_ip
            ;;
        show-logs)
            cmd_show_logs
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            echo "Unknown command: $command"
            echo
            usage
            exit 1
            ;;
    esac
}

# Run main with all arguments
main "$@"
