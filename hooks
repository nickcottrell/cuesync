#!/bin/bash
# Cuesync Deployment Hooks
# Simplified deployment pattern for cron-based execution node

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

SCHEDULE_FILE="schedule.yaml"
DEPLOY_CONFIG="deploy-config.yaml"
LOGS_DIR="$SCRIPT_DIR/logs"
ARCHIVE_DIR="$SCRIPT_DIR/logs/archive"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ============================================================
# UTILITY FUNCTIONS
# ============================================================

print_header() {
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "🔄 $1"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
}

print_step() {
  echo -e "${BLUE}▶${NC} $1"
}

print_success() {
  echo -e "${GREEN}✅${NC} $1"
}

print_error() {
  echo -e "${RED}❌${NC} $1"
}

print_warning() {
  echo -e "${YELLOW}⚠️${NC}  $1"
}

# ============================================================
# VALIDATION
# ============================================================

validate_local() {
  print_header "VALIDATING LOCAL CONFIGURATION"

  # Check schedule.yaml exists
  if [[ ! -f "$SCHEDULE_FILE" ]]; then
    print_error "Missing schedule.yaml"
    echo ""
    echo "This file should contain your cuesheet schedule."
    exit 1
  fi

  # Parse schedule.yaml
  if ! python3 -c "import yaml; yaml.safe_load(open('$SCHEDULE_FILE'))" 2>/dev/null; then
    print_error "Invalid YAML in schedule.yaml"
    exit 1
  fi

  print_success "schedule.yaml is valid"

  # Check deploy-config.yaml for deployment commands
  if [[ "$1" == "deploy" ]] && [[ ! -f "$DEPLOY_CONFIG" ]]; then
    print_error "Missing deploy-config.yaml"
    echo ""
    echo "Copy deploy-config.example.yaml to deploy-config.yaml"
    echo "Then fill in your server details."
    exit 1
  fi

  if [[ -f "$DEPLOY_CONFIG" ]]; then
    # Check for placeholder values
    if grep -q "your-server.example.com" "$DEPLOY_CONFIG" 2>/dev/null; then
      print_warning "deploy-config.yaml contains placeholder values"
      print_step "Update with your actual server details"
    else
      print_success "deploy-config.yaml is configured"
    fi
  fi
}

# ============================================================
# DEPLOYMENT
# ============================================================

deploy_to_server() {
  print_header "DEPLOYING TO SERVER"

  validate_local deploy

  # Extract server config
  SERVER_HOST=$(awk -F': ' '/^  host:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SERVER_USER=$(awk -F': ' '/^  user:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SSH_KEY=$(awk -F': ' '/^  ssh_key:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "' | sed "s|~|$HOME|")
  REMOTE_DIR=$(awk -F': ' '/^  remote_dir:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')

  if [[ -z "$SERVER_HOST" ]] || [[ "$SERVER_HOST" == "your-server.example.com" ]]; then
    print_error "Server host not configured in deploy-config.yaml"
    exit 1
  fi

  print_step "Connecting to $SERVER_USER@$SERVER_HOST"
  print_step "Remote directory: $REMOTE_DIR"
  echo ""

  # SSH and run deployment
  ssh -i "$SSH_KEY" "$SERVER_USER@$SERVER_HOST" << 'EOF'
    set -e

    # Navigate to cuesync directory
    cd ~/cuesync || {
      echo "❌ Cuesync not found. Run setup first."
      exit 1
    }

    echo "▶ Pulling latest cuesync config..."
    git pull origin main

    echo "▶ Pulling latest maestro code..."
    cd maestro
    git pull origin main
    cd ..

    echo "▶ Regenerating cron jobs..."
    ./sync.sh

    echo "✅ Deployment complete"
EOF

  print_success "Deployed successfully"
  echo ""
  print_step "Server will execute cuesheets on schedule"
  print_step "Run './hooks info' to see active cron jobs"
}

# ============================================================
# SERVER INFO
# ============================================================

show_server_info() {
  print_header "SERVER INFORMATION"

  if [[ ! -f "$DEPLOY_CONFIG" ]]; then
    print_error "Missing deploy-config.yaml"
    echo "Cannot connect to server without deployment config."
    exit 1
  fi

  # Extract server config
  SERVER_HOST=$(awk -F': ' '/^  host:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SERVER_USER=$(awk -F': ' '/^  user:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SSH_KEY=$(awk -F': ' '/^  ssh_key:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "' | sed "s|~|$HOME|")

  if [[ -z "$SERVER_HOST" ]] || [[ "$SERVER_HOST" == "your-server.example.com" ]]; then
    print_error "Server host not configured"
    exit 1
  fi

  print_step "Connecting to $SERVER_USER@$SERVER_HOST"
  echo ""

  ssh -i "$SSH_KEY" "$SERVER_USER@$SERVER_HOST" << 'EOF'
    echo "🔄 Cuesync Status"
    echo "============================"
    echo ""

    cd ~/cuesync || exit 1

    # Last sync time
    if [ -f "logs/sync.log" ]; then
      echo "Last Sync:"
      tail -n 1 logs/sync.log 2>/dev/null || echo "  Never"
    else
      echo "Last Sync: Never"
    fi
    echo ""

    # Active cron jobs
    echo "Active Cron Jobs:"
    crontab -l 2>/dev/null | grep -v "^#" | grep -v "^$" || echo "  (none)"
    echo ""

    # Recent logs
    echo "Recent Log Files:"
    ls -lt logs/*.log 2>/dev/null | head -n 5 || echo "  (no logs yet)"
EOF
}

# ============================================================
# TEST
# ============================================================

test_server() {
  print_header "TESTING SERVER"

  if [[ ! -f "$DEPLOY_CONFIG" ]]; then
    print_error "Missing deploy-config.yaml"
    exit 1
  fi

  SERVER_HOST=$(awk -F': ' '/^  host:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SERVER_USER=$(awk -F': ' '/^  user:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SSH_KEY=$(awk -F': ' '/^  ssh_key:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "' | sed "s|~|$HOME|")

  print_step "Testing connection to $SERVER_USER@$SERVER_HOST"

  if ssh -i "$SSH_KEY" -o ConnectTimeout=5 "$SERVER_USER@$SERVER_HOST" "echo '✅ Connection successful'"; then
    print_success "Server is reachable"
  else
    print_error "Cannot connect to server"
    exit 1
  fi
}

# ============================================================
# LOCAL STATUS (NO SERVER)
# ============================================================

show_local_status() {
  print_header "LOCAL SCHEDULE"

  if [[ ! -f "$SCHEDULE_FILE" ]]; then
    print_error "Missing schedule.yaml"
    exit 1
  fi

  # Parse schedule.yaml for schedule info
  python3 << 'PYTHON'
import yaml
from pathlib import Path

schedule_path = Path('schedule.yaml')
with open(schedule_path) as f:
    config = yaml.safe_load(f)

print(f"Sync Interval: {config.get('sync_interval', 'Not set')}")
print("")

print("Cuesheets:")
for cue in config.get('cuesheets', []):
    status = "✅ enabled" if cue.get('enabled', True) else "❌ disabled"
    desc = cue.get('description', '')
    print(f"  {cue['name']}")
    print(f"    Schedule: {cue['schedule']}")
    print(f"    Status: {status}")
    if desc:
        print(f"    Description: {desc}")
    print("")
PYTHON
}

# ============================================================
# LIST NEXT (SCHEDULED EXECUTIONS)
# ============================================================

list_next() {
  print_header "NEXT SCHEDULED EXECUTIONS"

  if [[ ! -f "$SCHEDULE_FILE" ]]; then
    print_error "Missing schedule.yaml"
    exit 1
  fi

  python3 << 'PYTHON'
import yaml
from pathlib import Path

schedule_path = Path('schedule.yaml')
with open(schedule_path) as f:
    config = yaml.safe_load(f)

print(f"Sync Interval: {config.get('sync_interval', 'Not set')}")
print("")

print("Cuesheets:")
for cue in config.get('cuesheets', []):
    status = "✅ enabled" if cue.get('enabled', True) else "❌ disabled"
    desc = cue.get('description', '')
    print(f"  {cue['name']}")
    print(f"    Schedule: {cue['schedule']}")
    print(f"    Status: {status}")
    if desc:
        print(f"    Description: {desc}")
    print("")
PYTHON
}

# ============================================================
# VIEW LOG
# ============================================================

view_log() {
  if [ -z "$1" ]; then
    print_error "Usage: ./hooks view-log <cuesheet-name>"
    echo ""
    echo "Available logs:"
    ls -1 "$LOGS_DIR"/*.log 2>/dev/null | xargs -n1 basename || echo "  (no logs yet)"
    exit 1
  fi

  LOG_FILE="$LOGS_DIR/$1.log"
  if [ ! -f "$LOG_FILE" ]; then
    print_error "Log not found: $LOG_FILE"
    exit 1
  fi

  print_header "LOG: $1.log"
  tail -n 50 "$LOG_FILE"
}

# ============================================================
# ARCHIVE LOGS
# ============================================================

archive_logs() {
  print_header "ARCHIVING OLD LOGS"

  mkdir -p "$ARCHIVE_DIR"

  ARCHIVE_DATE=$(date +%Y%m%d-%H%M%S)
  ARCHIVE_FILE="$ARCHIVE_DIR/logs-$ARCHIVE_DATE.tar.gz"

  OLD_LOGS=$(find "$LOGS_DIR" -name "*.log" -type f -mtime +7 2>/dev/null || true)

  if [ -z "$OLD_LOGS" ]; then
    print_success "No logs older than 7 days to archive"
    exit 0
  fi

  echo "$OLD_LOGS" | tar -czf "$ARCHIVE_FILE" -T -
  echo "$OLD_LOGS" | xargs rm -f

  print_success "Archived to: logs/archive/logs-$ARCHIVE_DATE.tar.gz"
  echo ""
  echo "Archived logs:"
  echo "$OLD_LOGS" | sed 's/^/  /'
}

# ============================================================
# DESTROY
# ============================================================

destroy_deployment() {
  print_header "DESTROYING DEPLOYMENT"

  if [[ ! -f "$DEPLOY_CONFIG" ]]; then
    print_error "Missing deploy-config.yaml"
    exit 1
  fi

  SERVER_HOST=$(awk -F': ' '/^  host:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SERVER_USER=$(awk -F': ' '/^  user:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "')
  SSH_KEY=$(awk -F': ' '/^  ssh_key:/ {print $2}' "$DEPLOY_CONFIG" | tr -d ' "' | sed "s|~|$HOME|")

  print_warning "This will remove all cron jobs from $SERVER_HOST"
  read -p "Are you sure? [y/N]: " -n 1 -r
  echo ""

  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_step "Cancelled"
    exit 0
  fi

  ssh -i "$SSH_KEY" "$SERVER_USER@$SERVER_HOST" << 'EOF'
    echo "▶ Removing cron jobs..."
    crontab -r 2>/dev/null || echo "No crontab to remove"
    echo "✅ Cron jobs removed"
EOF

  print_success "Deployment destroyed"
  print_warning "Server files remain. Manually delete ~/cuesync if needed."
}

# ============================================================
# COMMAND DISPATCHER
# ============================================================

show_usage() {
  cat <<EOF
🔄 Cuesync Deployment Hooks

Usage:
  ./hooks <command> [args]

Deployment Commands:
  validate      Validate schedule and deployment config
  deploy        Deploy to server (pull latest, regenerate cron)
  info          Show server status and active cron jobs
  test          Test server connection
  destroy       Remove cron jobs from server

Schedule Commands:
  list-next     Show next scheduled executions
  status        Show local schedule configuration

Log Commands:
  view-log <name>   View recent log for a cuesheet
  archive-logs      Archive logs older than 7 days

Examples:
  ./hooks validate
  ./hooks deploy
  ./hooks info
  ./hooks list-next
  ./hooks view-log morning-workflow

EOF
}

# Parse command
COMMAND=${1:-help}

case "$COMMAND" in
  validate)
    validate_local
    ;;
  deploy)
    deploy_to_server
    ;;
  info)
    show_server_info
    ;;
  test)
    test_server
    ;;
  destroy)
    destroy_deployment
    ;;
  list-next)
    list_next
    ;;
  status)
    show_local_status
    ;;
  view-log)
    view_log "$2"
    ;;
  archive-logs)
    archive_logs
    ;;
  help|--help|-h|"")
    show_usage
    ;;
  *)
    print_error "Unknown command: $COMMAND"
    echo ""
    show_usage
    exit 1
    ;;
esac
